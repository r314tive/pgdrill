{
  "apiVersion": "postgresql.cnpg.io/v1",
  "kind": "Cluster",
  "metadata": {
    "name": "altbox"
  },
  "spec": {
    "imageName": "ghcr.io/cloudnative-pg/postgresql:17.5",
    "plugins": [
      {
        "name": "telemetry.example.io",
        "enabled": false
      },
      {
        "name": "barman-cloud.cloudnative-pg.io",
        "isWALArchiver": true,
        "parameters": {
          "barmanObjectName": "altbox-backups",
          "serverName": "altbox-archive"
        }
      }
    ]
  }
}
